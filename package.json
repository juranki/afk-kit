{
	"name": "afk-kit",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"bin": {
		"afk": "./engine/cli.ts"
	},
	"description": "AFK delivery toolkit for pi: coordinator mechanics and workflow skills",
	"keywords": [
		"pi-package"
	],
	"scripts": {
		"test": "bun test --pass-with-no-tests",
		"lint": "biome check .",
		"deadcode": "KNIP_DISABLE_RAW_TRANSFER=1 knip",
		"verify": "bun test --pass-with-no-tests && biome check . && KNIP_DISABLE_RAW_TRANSFER=1 knip && bun scripts/drift-review.ts",
		"confinement:smoke": "bun scripts/confinement-smoke.ts"
	},
	"pi": {
		"extensions": [
			"./extensions/readiness/index.ts",
			"./extensions/coordinator/index.ts"
		],
		"skills": [
			"./skills"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "0.85.1",
		"typebox": "1.3.7",
		"@biomejs/biome": "2.5.14",
		"knip": "6.37.0"
	},
	"dependencies": {
		"@anthropic-ai/sandbox-runtime": "0.0.77"
	}
}
