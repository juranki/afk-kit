{
	// afk-kit's lint + format config. Rules are added only when one bites;
	// each addition carries a comment saying why.
	//
	// Scope boundary: extensions/subagent/ was vendored upstream code and was
	// excluded wholesale while it had to stay byte-identical (VENDORED.sha256).
	// Ticket #16 forked index.ts, agents.ts, and README.md — those files left
	// the sha manifest, so the exclusion is gone and the fork code is linted.
	// The still-unmodified vendored files (agents/*.md, prompts/*.md, LICENSE)
	// are not formats biome processes, so they need no exclusion.
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"files": {
		"includes": ["**"]
	},
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	}
}
