{
	// Dead-code/dependency/export detection. Entry points mirror the pi
	// manifest (package.json "pi" field); colocated *.test.ts files are entries
	// too. peerDependencies are runtime-provided by pi (they are also pinned
	// devDependencies so bun test can resolve the module graph).
	"$schema": "./node_modules/knip/schema.json",
	"entry": [
		"extensions/readiness/index.ts",
		"extensions/coordinator/index.ts",
		"scripts/**/*.test.ts",
		"extensions/readiness/**/*.test.ts",
		"extensions/coordinator/**/*.test.ts"
	]
}
